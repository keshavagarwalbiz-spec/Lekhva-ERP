# Lekhva ERP Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lekhva_erp"

# ─── Next.js ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ─── Business Details (Supplier) ──────────────────────────────────────
SUPPLIER_GSTIN="27XXXXX1234X1ZX"
SUPPLIER_STATE_CODE="27"
SUPPLIER_BUSINESS_NAME="Your Business Name"
SUPPLIER_ADDRESS="Your Business Address"
